<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details | perfume.co</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f7f8fb;
            color: #1a1a1a;
        }

        .detail-card {
            max-width: 650px;
            margin: 60px auto;
            border-radius: 20px;
            background: white;
            padding: 30px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.1);
        }

        .detail-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .detail-header h2 {
            font-weight: 700;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .label {
            font-weight: 600;
            color: #555;
        }

        .value {
            font-weight: 500;
        }

        .badge-role {
            background: #f0e1ff;
            color: #7c00ff;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .badge-banned {
            background: #ffecec;
            color: #c1121f;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .badge-active {
            background: #e8fff3;
            color: #0f9d58;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .btn-primary-soft {
            background: #a000ff;
            border: none;
        }

        .btn-primary-soft:hover {
            background: #8900d8;
        }
    </style>
</head>

<body>

    <!-- Optional admin navbar -->
    <%- include('partials/adminNavbar') %>

    <div class="container">

        <!-- Flash Messages -->
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success text-center"><%= success %></div>
        <% } %>
        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger text-center"><%= error %></div>
        <% } %>

        <% const user = userDetails[0]; %>

        <div class="detail-card">
            <div class="detail-header">
                <h2>User Details</h2>
                <p class="text-muted">User ID: <%= user.userId %></p>
            </div>

            <div class="info-row">
                <span class="label">Username</span>
                <span class="value"><%= user.username %></span>
            </div>

            <div class="info-row">
                <span class="label">Email</span>
                <span class="value"><%= user.email %></span>
            </div>

            <div class="info-row">
                <span class="label">Contact</span>
                <span class="value"><%= user.contact %></span>
            </div>

            <div class="info-row">
                <span class="label">Role</span>
                <span class="badge-role"><%= user.role %></span>
            </div>

            <div class="info-row">
                <span class="label">Account Status</span>
                <% if (user.banned === 1) { %>
                    <span class="badge-banned">Banned</span>
                <% } else { %>
                    <span class="badge-active">Active</span>
                <% } %>
            </div>

            <div class="info-row">
                <span class="label">Created At</span>
                <span class="value">
                    <%= new Date(user.createdAt).toLocaleString() %>
                </span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="/allUsers" class="btn btn-outline-dark">Back</a>
            </div>
        </div>
    </div>

</body>
</html>