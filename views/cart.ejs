<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YourScent.co - Cart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f7f8fb;
            color: #1a1a1a;
        }
        .page-title {
            font-weight: 700;
        }
        .cart-card {
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            background: #fff;
            padding: 18px;
            margin-bottom: 16px;
        }
        .cart-item {
            border-radius: 14px;
            padding: 12px;
            border: 1px solid #eef0f4;
            transition: all 0.2s ease;
        }
        .cart-item:hover {
            border-color: #d8c6ff;
            box-shadow: 0 10px 20px rgba(160, 0, 255, 0.08);
        }
        .qty-input {
            width: 90px;
        }
        .pill {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 999px;
            background: #eef0f4;
            font-size: 0.8rem;
            margin-right: 6px;
        }
        .btn-primary-soft {
            background: #a000ff;
            border: none;
        }
        .btn-primary-soft:hover {
            background: #8900d8;
        }
        .btn-danger-soft {
            background: #ffecec;
            color: #c1121f;
            border: 1px solid #ffd4d4;
        }
        .btn-danger-soft:hover {
            background: #ffc9c9;
            color: #9c0f19;
        }
        .order-summary {
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
        }
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body>
    <%- include('partials/customerNavbar') %>

    <div class="container mt-5 mb-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h2 class="page-title mb-1">Your Cart</h2>
                <p class="text-muted mb-0">Review your favourite scents before checkout.</p>
            </div>
            <a href="/shopping" class="btn btn-outline-dark mt-3 mt-md-0">Continue Shopping</a>
        </div>

        <% if (success && success.length > 0) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% if (!cartItems || cartItems.length === 0) { %>
            <div class="empty-state">
                <h4 class="mb-3">Your cart is empty</h4>
                <p class="text-muted mb-4">Start exploring our collection and add perfumes you love.</p>
                <a href="/shopping" class="btn btn-primary-soft text-white px-4">Browse Perfumes</a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <div class="col-lg-8">
                    <% cartItems.forEach((item) => { %>
                        <div class="cart-card">
                            <div class="row g-3 align-items-center cart-item">
                                <div class="col-4 col-md-3 col-lg-2">
                                    <img src="/images/<%= item.image %>" alt="<%= item.perfumeName %>" class="img-fluid rounded">
                                </div>
                                <div class="col">
                                    <h5 class="mb-1"><%= item.perfumeName %></h5>
                                    <p class="text-muted mb-1">$<%= Number(item.price || 0).toFixed(2) %> each</p>
                                    <% if (item.perfumeDescription) { %>
                                        <p class="text-muted small mb-2"><%= item.perfumeDescription.substring(0, 80) %><%= item.perfumeDescription.length > 80 ? '...' : '' %></p>
                                    <% } %>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <form class="d-flex align-items-center gap-2" action="/cart/update/<%= item.cartId %>" method="POST">
                                            <input type="number" name="quantity" class="form-control form-control-sm qty-input" min="1" value="<%= item.quantity %>">
                                            <button class="btn btn-primary-soft btn-sm text-white" type="submit">Update</button>
                                        </form>
                                        <form action="/cart/remove/<%= item.cartId %>" method="POST" onsubmit="return confirm('Remove this item from your cart?');">
                                            <button class="btn btn-danger-soft btn-sm" type="submit">Remove</button>
                                        </form>
                                    </div>
                                </div>
                                <div class="col-12 col-md-auto text-md-end">
                                    <div class="fw-semibold fs-5">$<%= Number(item.lineTotal || 0).toFixed(2) %></div>
                                    <div class="text-muted small">Subtotal</div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <div class="col-lg-4">
                    <div class="card order-summary">
                        <div class="card-body">
                            <h5 class="card-title">Order Summary</h5>
                            <div class="mb-3 pb-3 border-bottom">
                                <h6 class="mb-2">Items (<%= cartItems.reduce((sum, item) => sum + (item.quantity || 0), 0) %>)</h6>
                                <% cartItems.forEach((item) => { %>
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span>
                                            <%= item.perfumeName %>
                                            <span class="text-muted">x<%= item.quantity %></span>
                                        </span>
                                        <span class="fw-semibold">$<%= Number(item.lineTotal || 0).toFixed(2) %></span>
                                    </div>
                                <% }) %>
                            </div>
                            
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span>$<%= Number(cartTotal || 0).toFixed(2) %></span>
                            </div>
                            
                            <% if (appliedVoucher) { %>
                                <div class="alert alert-success py-2 mb-3" role="alert">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small fw-semibold"><%= appliedVoucher.code %></span>
                                        <form action="/cart/remove-voucher" method="POST" style="display: inline;">
                                            <button class="btn btn-sm btn-close" type="submit" aria-label="Remove voucher"></button>
                                        </form>
                                    </div>
                                    <small><%= appliedVoucher.description %></small>
                                </div>
                                <div class="d-flex justify-content-between mb-2 text-success">
                                    <span>Discount (<%= appliedVoucher.discountType === 'percentage' ? appliedVoucher.discountValue + '%' : '$' + Number(appliedVoucher.discountValue).toFixed(2) %>)</span>
                                    <span>-$<%= discountAmount %></span>
                                </div>
                            <% } else { %>
                                <div class="mb-3">
                                    <label for="voucherCode" class="form-label small">Have a voucher code?</label>
                                    <form action="/cart/apply-voucher" method="POST" class="d-flex gap-2">
                                        <input 
                                            type="text" 
                                            id="voucherCode"
                                            name="voucherCode" 
                                            class="form-control form-control-sm" 
                                            placeholder="Enter code"
                                            maxlength="20"
                                        >
                                        <button type="submit" class="btn btn-primary-soft btn-sm text-white">Apply</button>
                                    </form>
                                </div>
                            <% } %>

                            <div class="mb-3">
                                <label class="form-label small"><strong>Rewards Points</strong></label>
                                <div class="small text-muted mb-2">Available points: <%= Number(availablePoints || 0) %> (100 points = $1)</div>
                                <% if (pointsRedeemed && Number(pointsRedeemed) > 0) { %>
                                    <div class="alert alert-success py-2 d-flex justify-content-between align-items-center">
                                        <span class="small">Redeemed <strong><%= pointsRedeemed %></strong> points</span>
                                        <form action="/rewards/clear" method="POST">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <form action="/rewards/redeem" method="POST" class="d-flex gap-2">
                                        <input
                                            type="number"
                                            name="pointsToRedeem"
                                            class="form-control form-control-sm"
                                            min="100"
                                            step="100"
                                            max="<%= Number(availablePoints || 0) %>"
                                            placeholder="e.g. 200"
                                            required
                                        >
                                        <button type="submit" class="btn btn-primary-soft btn-sm text-white">Redeem</button>
                                    </form>
                                    <% if (Number(availablePoints || 0) < 100) { %>
                                        <div class="small text-muted mt-1">You need at least 100 points to redeem.</div>
                                    <% } %>
                                <% } %>
                            </div>

                            <% if (Number(rewardsDiscountApplied || 0) > 0) { %>
                                <div class="d-flex justify-content-between mb-2 text-success">
                                    <span>Rewards Discount</span>
                                    <span>-$<%= rewardsDiscountApplied %></span>
                                </div>
                            <% } %>

                            <div class="d-flex justify-content-between mb-2 small text-muted border-top pt-3">
                                <span>Subtotal</span>
                                <span>$<%= subtotal %></span>
                            </div>
                            
                            <div class="d-flex justify-content-between mb-3 small text-muted">
                                <span>GST (9%)</span>
                                <span>$<%= gst %></span>
                            </div>

                            <div class="d-flex justify-content-between mb-3 small text-muted">
                                <span>Shipping Fee <% if (Number(shippingFee) === 0) { %><span class="badge bg-success">FREE</span><% } %></span>
                                <span><% if (Number(shippingFee) === 0) { %>FREE<% } else { %>$<%= shippingFee %><% } %></span>
                            </div>

                            <div class="d-flex justify-content-between fw-semibold border-top pt-2">
                                <span>Total</span>
                                <span>$<%= finalTotal %></span>
                            </div>
                            
                            <div class="alert alert-info py-2 my-3 d-flex align-items-center gap-2">
                                <span style="font-size: 1.2rem;">📦</span>
                                <div>
                                    <small class="d-block"><strong>Estimated delivery:</strong> <%= deliveryInfo[deliveryOption].days %></small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small"><strong>Delivery Option</strong></label>
                                <form action="/cart/update-delivery" method="POST">
                                    <div class="form-check">
                                        <input 
                                            class="form-check-input" 
                                            type="radio" 
                                            name="deliveryOption" 
                                            id="standardDelivery" 
                                            value="standard"
                                            <%= deliveryOption === 'standard' ? 'checked' : '' %>
                                            onchange="this.form.submit();"
                                        >
                                        <label class="form-check-label" for="standardDelivery">
                                            Standard Delivery (3–5 working days)
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input 
                                            class="form-check-input" 
                                            type="radio" 
                                            name="deliveryOption" 
                                            id="expressDelivery" 
                                            value="express"
                                            <%= deliveryOption === 'express' ? 'checked' : '' %>
                                            onchange="this.form.submit();"
                                        >
                                        <label class="form-check-label" for="expressDelivery">
                                            Express Delivery (1–2 working days)
                                        </label>
                                    </div>
                                </form>
                            </div>

                            <a class="btn btn-primary-soft text-white w-100 mt-3" href="/checkout">Proceed to Checkout</a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>
